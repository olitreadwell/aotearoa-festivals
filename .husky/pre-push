#!/usr/bin/env sh

# Mirrors the GitHub Actions CI jobs — fail fast locally so broken work
# never leaves the machine. `npm run build` is intentionally not run here
# because it's slow; CI still runs it on every push.

set -e

echo "npm run lint"
npm run lint

echo "npm run typecheck"
npm run typecheck

echo "npm run format:check"
npm run format:check

echo "npm test"
npm test
