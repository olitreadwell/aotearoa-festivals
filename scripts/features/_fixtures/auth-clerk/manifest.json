{
  "id": "auth-clerk",
  "category": "auth",
  "label": "Clerk",
  "description": "Hosted auth with prebuilt UI.",
  "dependencies": ["@clerk/nextjs@^6", "zod@^3.23"],
  "devDependencies": [],
  "envKeys": [
    {
      "name": "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
      "required": true,
      "description": "Clerk publishable key.",
      "public": true
    },
    {
      "name": "CLERK_SECRET_KEY",
      "required": true,
      "description": "Clerk secret key.",
      "public": false
    }
  ],
  "files": [
    {
      "from": "middleware.ts",
      "to": "apps/${PROJECT_NAME}/middleware.ts",
      "overwrite": false
    }
  ],
  "readmeSection": "## Clerk\n\nAuthentication is handled by Clerk.\n",
  "postInstall": [],
  "conflicts": ["auth-kinde"],
  "requires": []
}
