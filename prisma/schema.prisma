generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Region taxonomy, matching nz-tech-events' HasRegion concern (18 values).
enum Region {
  NORTHLAND
  AUCKLAND
  WAIKATO
  BAY_OF_PLENTY
  GISBORNE
  HAWKES_BAY
  TARANAKI
  MANAWATU_WHANGANUI
  WELLINGTON
  WAIRARAPA
  TASMAN
  NELSON
  MARLBOROUGH
  WEST_COAST
  CANTERBURY
  OTAGO
  SOUTHLAND
  ONLINE
}

enum FestivalStatus {
  ACTIVE
  TBC
  HIATUS
  DEFUNCT
  UNCONFIRMED
}

enum UserRole {
  ADMIN
  ORGANISER
  USER
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  role          UserRole @default(USER)
  googleUid     String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  festivals     Festival[] @relation("SubmittedBy")
}

model EmailSubscription {
  id        String   @id @default(cuid())
  email     String
  region    Region
  token     String   @unique @default(cuid())
  createdAt DateTime @default(now())

  @@unique([email, region])
}

model Promoter {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  region      String?
  genreFocus  String?
  instagram   String?
  facebook    String?
  website     String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  festivals   Festival[]
}

model Festival {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  status        FestivalStatus @default(ACTIVE)
  region        Region?
  location      String?
  genre         String?
  costText      String?
  dateText      String?
  startDate     DateTime?
  endDate       DateTime?
  notes         String?
  website       String?
  approved      Boolean        @default(true)

  promoterId    String?
  promoter      Promoter?      @relation(fields: [promoterId], references: [id])

  submittedById String?
  submittedBy   User?          @relation("SubmittedBy", fields: [submittedById], references: [id])

  lineups       LineupEntry[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
  @@index([region])
}

model Artist {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  genre       String?
  homeCity    String?
  crew        String?
  instagram   String?
  soundcloud  String?
  raUrl       String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lineups     LineupEntry[]
}

// One row per (festival, year, artist) — an artist playing a given
// festival's given yearly edition. Source is kept per-entry since lineup
// data is scraped from many places with very uneven reliability.
model LineupEntry {
  id         String   @id @default(cuid())
  festivalId String
  festival   Festival @relation(fields: [festivalId], references: [id], onDelete: Cascade)
  artistId   String
  artist     Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  year       Int
  isHeadliner Boolean @default(false)
  source     String?
  createdAt  DateTime @default(now())

  @@unique([festivalId, artistId, year])
  @@index([year])
}
