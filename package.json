{
  "name": "aotearoa-festivals",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.17.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "test:unit": "turbo test --",
    "test:coverage": "turbo test:coverage",
    "test:e2e": "turbo test:e2e",
    "test:a11y": "turbo test:a11y",
    "test:visual": "turbo test:visual",
    "storybook": "turbo storybook --filter=@numeral/ui",
    "build:storybook": "turbo build-storybook --filter=@numeral/ui",
    "clean": "rm -rf .turbo apps/*/.next apps/*/.turbo apps/*/dist apps/*/tsconfig.tsbuildinfo apps/*/coverage apps/*/playwright-report apps/*/test-results packages/*/.turbo packages/*/dist packages/*/tsconfig.tsbuildinfo packages/*/.rollup.cache packages/*/coverage packages/*/storybook-static",
    "clean:all": "rm -rf node_modules apps/*/node_modules packages/*/node_modules .turbo apps/*/.next apps/*/.turbo apps/*/dist apps/*/tsconfig.tsbuildinfo apps/*/coverage apps/*/playwright-report apps/*/test-results packages/*/.turbo packages/*/dist packages/*/tsconfig.tsbuildinfo packages/*/.rollup.cache packages/*/coverage packages/*/storybook-static && npm cache clean --force",
    "prepare": "husky",
    "setup": "node scripts/setup.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,css,scss,yml,yaml}": "prettier --write",
    "*.{ts,tsx,js,mjs}": "eslint --fix --no-warn-ignored"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.47.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/leaflet": "^1.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.400.0",
    "next": "^16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^2.5.0"
  },
  "description": "New Zealand music festivals, promoters, and the artists who play them",
  "repository": {
    "type": "git",
    "url": "https://github.com/olitreadwell/aotearoa-festivals"
  }
}