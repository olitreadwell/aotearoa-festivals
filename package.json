{
  "name": "aotearoa-festivals",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.17.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npx prisma generate && next build",
    "start": "next start",
    "setup": "echo 'kiwi-fests: prepare local data with db:push and db:seed'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "npx prettier --write \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\"",
    "format:check": "npx prettier --check \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test a11y",
    "perf": "pnpm dlx @lhci/cli@latest autorun",
    "smoke": "bash scripts/smoke.sh",
    "check:links": "node scripts/check-internal-links.mjs",
    "check:external-links": "node scripts/check-external-links.mjs",
    "audit": "pnpm audit",
    "test:setup": "echo 'kiwi-fests: no scaffolder; nothing to test'",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run smoke && npm run test:e2e && npm run check:links",
    "prepare": "husky",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,css,scss,yml,yaml}": "prettier --write",
    "*.{ts,tsx,js,mjs}": "eslint --fix --no-warn-ignored"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.47.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "8.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.2",
    "eslint-plugin-jsdoc": "64.2.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "husky": "9.1.7",
    "jsdom": "^30.0.1",
    "pino-pretty": "13.1.3",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0",
    "vitest-axe": "0.1.0",
    "@types/leaflet": "^1.9.0",
    "prisma": "^6.19.3",
    "tsx": "^4.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "feed": "^6.0.0",
    "fuse.js": "^7.5.0",
    "geist": "1.7.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.400.0",
    "next": "^16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^2.5.0"
  },
  "description": "New Zealand music festivals, promoters, and the artists who play them",
  "repository": {
    "type": "git",
    "url": "https://github.com/olitreadwell/aotearoa-festivals"
  }
}
