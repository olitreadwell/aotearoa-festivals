{
  "name": "@numeral/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,scss,json}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:e2e": "playwright test",
    "test:e2e:critical": "playwright test --grep @critical",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "clean": "rm -rf .next .turbo tsconfig.tsbuildinfo",
    "clean:all": "rm -rf .next .turbo tsconfig.tsbuildinfo node_modules"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@numeral/ui": "*",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.72.0",
    "zod": "^3.23",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@numeral/config-eslint": "*",
    "@numeral/config-tailwind": "*",
    "@numeral/config-typescript": "*",
    "@playwright/test": "^1.51.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.31.0",
    "jest-axe": "^9.0.0",
    "postcss": "^8.5.2",
    "sass": "^1.86.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
